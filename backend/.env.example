# Preferred provider (set one)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_APP_URL=http://127.0.0.1:5500
OPENROUTER_APP_NAME=Chennai Travel Safety AI

# Optional alternate provider
GROQ_API_KEY=your_groq_api_key_here

# Optional model override
GROQ_MODEL=llama-3.3-70b-versatile

# Optional full prompt override (single line or escaped newlines)
TRAVEL_SYSTEM_PROMPT=

# Flask runtime
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false

# CORS allowlist (set to your frontend origin in production)
FRONTEND_ORIGIN=http://127.0.0.1:5500
